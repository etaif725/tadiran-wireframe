# Public origin used for metadata, CORS, and sitemap.
SITE_URL=http://localhost:3000

# Set to true only after legal and launch approval. Controls robots and indexing.
LAUNCH_APPROVED=false

# Partner portal. The login page redirects here when this is a valid https URL.
PARTNER_PORTAL_URL=

# Privacy policy. The /privacy route redirects here when this is a valid https URL.
PRIVACY_POLICY_URL=

# Inquiry delivery. The form stays closed until every value below is set.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
